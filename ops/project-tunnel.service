[Unit]
Description=Project bridge tunnel relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/adebechigef
ExecStart=/usr/bin/python3 /var/www/adebechigef/tunnel_server.py --port 9877
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
